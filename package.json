{
  "name": "termlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "termlink": "./bin/termlink.js"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "esbuild web/src/index.ts --bundle --outfile=web/dist/bundle.js --loader:.css=css --loader:.ttf=dataurl --target=es2020 --format=iife --sourcemap",
    "cli": "node dist/cli/src/index.js",
    "dev": "tsx server/src/index.ts",
    "dev:cli": "tsx cli/src/index.ts",
    "dev:client": "tsx client/src/index.ts",
    "dev:agent": "tsx agent/src/index.ts",
    "dev:android-agent": "tsx agent/src/android-agent.ts",
    "dev:relay": "tsx relay/src/index.ts",
    "dev:web": "esbuild web/src/index.ts --bundle --outfile=web/dist/bundle.js --loader:.css=css --loader:.ttf=dataurl --servedir=web --target=es2020 --format=iife --sourcemap",
    "start": "node dist/server/src/index.js",
    "start:relay": "node dist/relay/src/index.js",
    "start:agent": "node dist/agent/src/index.js",
    "start:android-agent": "node dist/agent/src/android-agent.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}

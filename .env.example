# TCP Server Configuration
HOST=127.0.0.1
PORT=9000

# Protocol
PROTOCOL_VERSION=1
MAX_FRAME_SIZE=1048576

# Connection Limits
MAX_CONNECTIONS=100
IDLE_TIMEOUT_MS=30000

# Authentication
# Space-separated pre-shared tokens (raw values; the server stores them hashed)
# AUTH_TOKENS=my-secret-token-1 my-secret-token-2
#
# Alternatively, load credentials from files (secret mounts). The file content
# has the same format as the inline value and overrides it if both are set. The
# server never logs either.
# AUTH_TOKENS_FILE=/run/secrets/auth-tokens
# PASSWORD_USERS_FILE=/run/secrets/password-users

# Username:password pairs for password auth (comma-separated)
PASSWORD_USERS=admin:changeme,user2:password2

# Brute-force Protection
MAX_AUTH_ATTEMPTS=5
AUTH_BACKOFF_MS=1000

# Authentication hardening (can be zero to "require nothing treated as disabled")
AUTH_TIMEOUT_MS=10000        # 0 = no deadline for unauthenticated connections
AUTH_RATE_LIMIT=0            # 0 = disabled; global auth attempts per window
AUTH_PER_IP_RATE_LIMIT=0     # 0 = disabled; auth attempts per remote address
AUTH_RATE_WINDOW_MS=60000    # window for the rate limits above
SESSION_TTL_MS=0             # 0 = sessions live until disconnect; else max age

# Echo incoming data back to the sender (demo/testing only)
ECHO_DATA=true

# PTY backend: spawn an isolated interactive shell per authenticated connection
# (browser → WebSocket → relay → TCP → server → PTY → shell).
# PTY_ENABLED=false
# PTY_SHELL=/bin/bash             # executable path from trusted server config only
# PTY_COLS=80                     # default terminal size
# PTY_ROWS=24
# PTY_CWD=/home/user              # working directory for spawned shells

# ─────────────────────────────────────────────────────────────
# SSH backend: open an interactive shell on a remote host per authenticated
# connection (browser → WebSocket → relay → TCP → server → SSH → remote shell).
# Only ONE terminal backend can be enabled at a time: PTY and SSH are mutually
# exclusive. The SSH target is static trusted server configuration — clients can
# never choose the host, port, user, credentials, or command. An interactive
# shell is used; remote command execution is not supported.
# SSH_ENABLED=true
# SSH_HOST=bastion.example.com              # required when enabled
# SSH_PORT=22                               # 1-65535, default 22
# SSH_USERNAME=deploy                       # required when enabled
# SSH_PASSWORD=...                          # or SSH_PASSWORD_FILE=/run/secrets/ssh-password
# SSH_PRIVATE_KEY=...                       # or SSH_PRIVATE_KEY_FILE=...; PEM/OpenSSH key
# SSH_PASSPHRASE=...                        # passphrase for an encrypted private key
# SSH_CONNECT_TIMEOUT_MS=15000              # handshake deadline
# SSH_COLS=80
# SSH_ROWS=24
# SSH_TERM=xterm-256color

# SSH host-key verification (secure default): when SSH is enabled you MUST
# provide SSH_KNOWN_HOSTS_FILE and/or SSH_HOST_KEY_FINGERPRINTS, or explicitly
# set SSH_INSECURE_HOST_KEY_CHECK=true to disable verification.
# SSH_KNOWN_HOSTS_FILE=/etc/ssh/known_hosts   # OpenSSH format (glob, port, hashed)
# SSH_HOST_KEY_FINGERPRINTS=SHA256:AAAA...    # space/comma-separated; SSH_KEYGEN like
# SSH_INSECURE_HOST_KEY_CHECK=false           # true = accept any host key (warning)

# ─────────────────────────────────────────────────────────────
# TLS (server role — TCP backend / WSS front door)
# Add cert/key to turn the component's listener into TLS, then point every
# downstream consumer at the CA. Certs can be inline or read from files; the
# _FILE form wins when both are present.
# TLS_ENABLED=true
# TLS_CERT_FILE=/etc/tls/server-cert.pem      # or TLS_CERT=<inline PEM>
# TLS_KEY_FILE=/etc/tls/server-key.pem        # or TLS_KEY=<inline PEM>
# TLS_CA_FILE=/etc/tls/ca-cert.pem            # optional; PEM chain for verifying peer certs

# TLS (client role — relay→backend): the relay uses the same TLS_ENABLED flag
# plus the client-side controls below. When TLS_ENABLED=true with a WSS front
# door, set BOTH the server material (above) and the client material (below).
# TLS_CA_FILE=/etc/tls/ca-cert.pem            # CA that signed the backend's cert
# TLS_SERVER_NAME=localhost                   # hostname to verify against the cert
# TLS_REJECT_UNAUTHORIZED=true                # false only for local smoke tests
# TLS_CLIENT_CERT_FILE=/etc/tls/client-cert.pem   # optional mutual TLS pair
# TLS_CLIENT_KEY_FILE=/etc/tls/client-key.pem

# ─────────────────────────────────────────────────────────────
# TCP Client Configuration
# The client connects to the server on SERVER_HOST:SERVER_PORT.
SERVER_HOST=127.0.0.1
SERVER_PORT=9000

# Credentials (token OR username/password)
AUTH_TOKEN=my-secret-token-1
USERNAME=admin
PASSWORD=changeme

# Client timeouts and limits
CONNECT_TIMEOUT_MS=10000
CLIENT_IDLE_TIMEOUT_MS=60000
CLIENT_MAX_FRAME_SIZE=1048576

# Reconnect behavior
RECONNECT=true
RECONNECT_DELAY_MS=1000
MAX_RECONNECT_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# Relay Configuration
# The relay authenticates clients against its OWN credentials and forwards each
# authenticated session to a configured static target.
RELAY_HOST=127.0.0.1
RELAY_PORT=19000

# Static authorized targets, comma-separated:
#   [id]|[Display Name]|type=[creds@]host:port
# The optional creds@ prefix is the relay→backend authentication credential and
# is never shared with clients: a token (backendtok@host:port) or
# username:password (user:pass@host:port). Creds must not contain '@'; token
# creds must not contain ':'.
# Metadata segments feed the Phase 8 web GUI: `id` selects the device via
# /ws?device=<id>&type=<type>, `Display Name` is shown to browsers, and
# `type=` is the terminal backend the device offers (shell | ssh). Legacy forms
# are backward compatible: targetId=[creds@]host:port (name=id, type=shell).
TARGETS=web|Main Gateway|shell=backendtok@127.0.0.1:2222,ops|Prod Bastion|ssh=ops@192.168.1.5:22

# Phase 9 & 10 device agents (pre-authorized devices that connect OUT to this relay).
# Comma-separated; grammar:
#   id|Display Name|type[|enrollmentToken]
# `type` is `shell` or `android`. The optional 4th segment is a per-device
# enrollment token: when present, an agent must echo it in its device_register
# message to claim the device. Without it, the FIRST agent to connect with that
# id may enroll (the relay warns once). The agent generates its own secret at
# enrollment; this relay stores only an scrypt hash. The device needs no inbound
# ports and no SSH: it keeps a persistent outbound link, and browsers open
# isolated local shells on it through the web GUI, multiplexed over that link.
# DEVICES=laptop|Alice's laptop|shell,phone|Android Phone|android|tok-abc-123
DEVICES=

# Browser device access for agent devices mirrors static targets: browsers list
# them in /api/devices, create sessions in /api/devices/<id>/sessions (refused
# while the device is offline), and connect via
# /ws?device=<id>&type=shell&session=<sessionId> (or type=android). Device
# credentials never leave the agent.

# WebSocket front door (browser client / web GUI)
# WS_ENABLED=true                     # or set WS_PORT explicitly
# WS_HOST=127.0.0.1                   # default: RELAY_HOST (or HOST)
# WS_PORT=19001                       # must differ from RELAY_PORT (or use RELAY_PORT=0 for PaaS/Render)
# WS_MAX_CONNECTIONS=100
# WS_MAX_MESSAGE_SIZE=1048576
# WS_IDLE_TIMEOUT_MS=30000
# WS_ALLOWED_ORIGINS=https://app.example.com   # comma-separated; empty = any origin
#                                             # (startup warning; set for production)
# WS_STATIC_DIR=web                    # optional; serve the browser bundle (the web GUI)
#                                     # over the same front door (alias: WEB_STATIC_DIR)

# Relay authentication hardening (same semantics as the server's)
# AUTH_TIMEOUT_MS=10000
# AUTH_RATE_LIMIT=0
# AUTH_PER_IP_RATE_LIMIT=0
# AUTH_RATE_WINDOW_MS=60000
# SESSION_TTL_MS=0

# ─────────────────────────────────────────────────────────────
# Device Agent Configuration (PC / Android Termux — Phase 9 & 10)
# Runs on the machine or Android device whose shells you want the browser to reach.
# The agent needs ONLY an outbound wss:// connection to the relay's /device endpoint —
# no inbound ports, no SSH daemon. Agent devices must be pre-authorized in the
# relay's DEVICES setting above.
# RELAY_URL=wss://relay.example.com        # ws:// for local development (required)
# AGENT_DEVICE_ID=laptop                    # must match a DEVICES id (required)
# AGENT_ENROLLMENT_TOKEN=...                # echo if the relay configured one
# AGENT_CREDENTIALS_FILE=agent-device.secret  # device identity persisted 0600
#
# The agent spawns shells from TRUSTED local configuration only — browsers can
# never choose the command, executable path, environment, or working directory.
# AGENT_SHELL=/bin/bash                     # default: $SHELL (or Termux bash)
# AGENT_CWD=/home/user                      # default: $HOME (or Termux home)
# AGENT_WAKE_LOCK=true                      # Termux: acquire CPU wake lock via termux-wake-lock
# AGENT_PING_INTERVAL_MS=20000              # heartbeat to keep the relay's last-seen fresh
# AGENT_IDLE_TIMEOUT_MS=90000               # drop if no relay traffic in this window
# AGENT_RECONNECT_MIN_MS=500                # bounded exponential reconnect backoff
# AGENT_RECONNECT_MAX_MS=30000
# AGENT_RECONNECT_FACTOR=2

# ─────────────────────────────────────────────────────────────
# Render Deployment
# When deploying on Render Web Services, set these environment variables in the
# Render dashboard (or use the included render.yaml blueprint):
#
# RENDER=true                  # Auto-detects Render: maps PORT → WS_PORT, RELAY_PORT=0
# AUTH_TOKENS=<your-token>     # Required: relay auth token for browser/agent login
# DEVICES=<device-config>      # Required: pre-authorized devices, e.g. "laptop|PC|shell|tok-abc"
# WS_ALLOWED_ORIGINS=https://your-app.onrender.com  # Required: origin validation
# WS_STATIC_DIR=web           # Serve the built Web GUI (web/index.html + web/dist/) from the same origin
#
# The relay binds the public HTTP/WSS listener to 0.0.0.0:$PORT and the internal
# TCP backend relay to an ephemeral port (RELAY_PORT=0). No manual port config
# is needed — Render provides the PORT. TLS is terminated by Render's proxy; the
# Node process itself does NOT need TLS certs. Agent devices connect outbound
# via wss://your-app.onrender.com/device.
